apiVersion: v1
kind: ConfigMap
metadata:
  name: abs-auth-proxy
  namespace: media
  labels:
    app.kubernetes.io/name: abs-auth-proxy
data:
  nginx.conf: |
    worker_processes auto;
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }

    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;

      # Log enough to tell an nginx 401 (a Basic auth challenge this proxy
      # issued) apart from a 401 Audiobookshelf itself returned. $upstream_status
      # is empty when the request never reached ABS, so "401 -" means the gate
      # challenged the client while "401 401" means ABS rejected the request.
      log_format absgate '$remote_addr - $remote_user [$time_local] '
                         '"$request" $status up=$upstream_status '
                         'ua="$http_user_agent" auth="$http_authorization"';
      access_log /dev/stdout absgate;

      # Only send "Connection: upgrade" when the client actually asked to
      # upgrade. Sending it unconditionally (as this file used to) on plain
      # asset GETs is malformed, breaks keep-alive, and makes browsers retry
      # the request - each retry re-triggers the Basic auth challenge, which is
      # what produced the endless sign-in prompts.
      map $http_upgrade $abs_connection_upgrade {
        default upgrade;
        ''      close;
      }

      # Dedicated, slower zone for the login form so password guessing cannot
      # burn the budget the audiobook stream needs.
      limit_req_zone $binary_remote_addr zone=abslogin:10m rate=1r/s;

      # Emit relative Location headers (Location: /login) instead of absolute
      # ones. The Cloudflare connector rewrites Host to audiobookshelf.media.svc,
      # so nginx has no idea what public hostname the browser used; left to
      # build an absolute URL it invents audiobookshelf.media.svc:8080 and sends
      # the browser to an in-cluster address that does not resolve. A relative
      # redirect keeps the browser on whichever public hostname it arrived with,
      # which is what we want when the Quick Tunnel hostname rotates.
      absolute_redirect off;

      # Rate limit by client IP. zone is shared state across workers.
      limit_req_zone $binary_remote_addr zone=absreq:10m rate=10r/s;
      limit_req_status 429;
      limit_conn_zone $binary_remote_addr zone=absconn:10m;
      limit_conn_status 429;

      # Long timeouts: an audiobook is one long-lived response.
      proxy_connect_timeout 30s;
      proxy_send_timeout 3600s;
      proxy_read_timeout 3600s;
      send_timeout 3600s;

      upstream audiobookshelf {
        server audiobookshelf.media.svc:80;
        keepalive 32;
      }

      server {
        # 8080, not 80: this container is uid 101 with every capability
        # dropped, so it cannot bind a privileged port. The Service maps
        # 80 -> 8080 so callers are unaffected.
        listen 8080;
        server_name _;

        # Gate order matters: reject floods before spending CPU on bcrypt.
        limit_req zone=absreq burst=20 nodelay;
        limit_conn absconn 20;

        # Health endpoint stays open (no password) so probes can check the proxy
        # without credentials. Answers locally rather than proxying: ABS's own
        # /healthcheck sits behind the gate above, so probing it here would
        # return 401 and never let the pod become Ready.
        location = /healthz {
          access_log off;
          default_type text/plain;
          return 200 "ok\n";
        }

        # The gate: the abs-gate sidecar on loopback validates the signed
        # session cookie. Internal, so nginx never routes to it from outside.
        #
        # 200 = valid session, 401 = no session. nginx distinguishes this from
        # Audiobookshelf's own 401 with $gate_denied (the auth_request
        # subrequest status) and redirects only in that case, so a failed ABS
        # login shows the ABS login form rather than looping back here.
        location = /_gate_authz {
          internal;
          proxy_pass http://127.0.0.1:9001/authz;
          proxy_pass_request_body off;
          proxy_set_header Content-Length "";
          proxy_set_header Cookie $http_cookie;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $http_host;
          proxy_set_header X-Original-URI $request_uri;

          # No auth_request_set here: those belong in the location that calls
          # auth_request (see location / and $gate_denied).
        }

        # Login form. Rate limited harder than the app itself because it is the
        # only endpoint that takes a password.
        location = /login {
          limit_req zone=abslogin burst=10 nodelay;
          proxy_pass http://127.0.0.1:9001;
          proxy_set_header Host $http_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $http_host;
        }

        location = /logout {
          proxy_pass http://127.0.0.1:9001;
          proxy_set_header Host $http_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header Cookie $http_cookie;
          proxy_set_header X-Forwarded-Proto $scheme;
        }

        location @gate_login {
          # Only reached for the gate's own 401: ABS's 401 leaves $gate_denied
          # empty, so error_page falls through and ABS's response is served
          # as-is. $gate_denied is inherited from the main request's
          # auth_request subrequest.
          if ($gate_denied) {
            return 302 /login;
          }
          return 401;
        }

        location / {
          # Gate first, then proxy to ABS in the same location: auth_request
          # runs as an access-phase subrequest, so an invalid cookie never
          # reaches Audiobookshelf.
          auth_request /_gate_authz;
          auth_request_set $gate_denied $upstream_status;

          # Redirect to the gate's login page when the 401 came from the gate.
          #
          # A redirect driven by error_page 401 = $var is what this originally
          # used and it is wrong: nginx resolves the variable per-request but
          # still emits the redirect when it is empty, so an Audiobookshelf 401
          # turned into a bodyless 302 that bounced the SPA back to itself.
          # $gate_denied distinguishes the two 401s reliably (the subrequest
          # only runs on the gate's path) and @gate_login decides explicitly.
          error_page 401 = @gate_login;

          proxy_pass http://audiobookshelf;
          proxy_http_version 1.1;

          # Websocket upgrade - Audiobookshelf socket.io needs these. The
          # Connection value is mapped, so plain requests get "close" instead of
          # a bogus "upgrade" (see the map block above).
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $abs_connection_upgrade;
          proxy_set_header Host audiobookshelf.media.svc;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;

          # Do not buffer audio: it is a stream, and buffering adds latency.
          proxy_buffering off;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
