    spec:
      # No API access needed.
      automountServiceAccountToken: false
      # Keep off kubernetes7 (failing disk); spread across the rest.
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: NotIn
                    values: ["kubernetes7"]
      # Keep the two replicas on different nodes. Without this the scheduler is
      # free to place both on one node, in which case a node failure takes out
      # both and "replicas: 2" provides no availability at all. DoNotSchedule is
      # deliberate: with only 10 nodes and several already excluded, preferring a
      # soft skew would silently co-locate them again.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              app: abs-auth-proxy
      tolerations:
        - key: node-role.kubernetes.io/master
          operator: Exists
          effect: NoSchedule
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        fsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: nginx
          # Unprivileged image, runs as uid 101 and listens on 8080 unprivileged.
          image: docker.io/nginxinc/nginx-unprivileged:1.27-alpine
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          env:
            # nginx-unprivileged image entrypoint runs `nginx -g daemon off;`.
            # Templates the config so /tmp stays writable under a read-only fs.
            - name: NGINX_ENVSUBST_OUTPUT_DIR
              value: /tmp
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 20
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 300m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            # Unprivileged nginx needs writable /tmp and cache/run dirs.
            - name: tmp
              mountPath: /tmp
            - name: cache
              mountPath: /var/cache/nginx
            - name: run
              mountPath: /var/run
        # Session-cookie gate. Replaces auth_basic, which Chrome re-challenged
        # endlessly over HTTP/2 at the Cloudflare edge.
        - name: gate
          image: docker.io/library/python:3.12-alpine
          imagePullPolicy: IfNotPresent
          command: ["python3", "/app/abs-gate.py"]
          env:
            - name: GATE_PASSWORD_ENTRY
              valueFrom:
                secretKeyRef:
                  name: abs-gate
                  key: passwordEntry
            - name: GATE_SESSION_SECRET
              valueFrom:
                secretKeyRef:
                  name: abs-gate
                  key: sessionSecret
            - name: GATE_USERNAME
              value: absproxy
            - name: GATE_PORT
              value: "9001"
            - name: GATE_TTL_SECONDS
              value: "604800"
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
          ports:
            # Loopback only, but a port must be declared for no reason other
            # than documentation: nothing routes to this container, nginx calls
            # it over 127.0.0.1 inside the pod.
            - name: gate
              containerPort: 9001
              protocol: TCP
          # exec, not httpGet: the gate deliberately binds 127.0.0.1 so nothing in the
          # cluster can reach it, but kubelet's HTTP probe runs from outside the
          # pod's network namespace and could never connect. An exec probe
          # preserves the loopback-only bind.
          readinessProbe:
            exec:
              command:
                - python3
                - -c
                - |
                  import sys, urllib.request
                  sys.exit(0 if urllib.request.urlopen(
                      "http://127.0.0.1:9001/healthz", timeout=3).status == 200 else 1)
            initialDelaySeconds: 5
            periodSeconds: 10
            # Interpreter startup dominates: the probe itself answers in
            # milliseconds, but python3 -c costs ~1s to boot on this image, and
            # under CPU contention that exceeded a 5s budget and the kubelet
            # killed a perfectly healthy container.
            timeoutSeconds: 15
            failureThreshold: 3
          livenessProbe:
            exec:
              command:
                - python3
                - -c
                - |
                  import sys, urllib.request
                  sys.exit(0 if urllib.request.urlopen(
                      "http://127.0.0.1:9001/healthz", timeout=3).status == 200 else 1)
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 15
            failureThreshold: 3
          resources:
            requests:
              cpu: 10m
              memory: 24Mi
            limits:
              cpu: 200m
              memory: 96Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: gate-app
              mountPath: /app
              readOnly: true
            - name: gate-tmp
              mountPath: /tmp
      volumes:
        - name: config
          configMap:
            name: abs-auth-proxy
        - name: tmp
          emptyDir:
            sizeLimit: 32Mi
        - name: cache
          emptyDir:
            sizeLimit: 32Mi
        - name: run
          emptyDir:
            sizeLimit: 8Mi
        - name: gate-app
          configMap:
            name: abs-gate-app
            defaultMode: 0555
        - name: gate-tmp
          emptyDir:
            sizeLimit: 8Mi
