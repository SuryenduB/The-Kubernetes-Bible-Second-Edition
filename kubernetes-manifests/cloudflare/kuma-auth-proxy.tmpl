apiVersion: v1
kind: ConfigMap
metadata:
  name: kuma-auth-proxy
  namespace: monitoring
  labels:
    app.kubernetes.io/name: kuma-auth-proxy
data:
  nginx.conf: |
    worker_processes auto;
    error_log /dev/stderr warn;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }

    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;

      # Log enough to tell a gate 401 from an Uptime-Kuma-issued 401:
      # $upstream_status is empty when the request never reached Kuma, so
      # "401 -" means the gate challenged the client while "401 401" means
      # Kuma itself rejected the request.
      log_format kumagate '$remote_addr - $remote_user [$time_local] '
                          '"$request" $status up=$upstream_status '
                          'ua="$http_user_agent"';
      access_log /dev/stdout kumagate;

      # Only send "Connection: upgrade" when the client actually asked to
      # upgrade. Unconditional upgrade headers break keep-alive and make
      # browsers retry plain asset GETs.
      map $http_upgrade $kuma_connection_upgrade {
        default upgrade;
        ''      close;
      }

      # Dedicated, slower zone for the login form so password guessing cannot
      # burn the budget the dashboard needs.
      limit_req_zone $binary_remote_addr zone=kumalogin:10m rate=1r/s;

      # Emit relative Location headers (Location: /login) instead of absolute
      # ones. The Quick Tunnel hostname rotates on every connector restart and
      # nginx has no idea what public hostname the browser used; a relative
      # redirect keeps the browser on whichever hostname it arrived with.
      absolute_redirect off;

      # Rate limit by client IP. zone is shared state across workers.
      limit_req_zone $binary_remote_addr zone=kumareq:10m rate=10r/s;
      limit_req_status 429;
      limit_conn_zone $binary_remote_addr zone=kumaconn:10m;
      limit_conn_status 429;

      # Long timeouts: socket.io dashboards idle a lot and only ping slowly.
      proxy_connect_timeout 30s;
      proxy_send_timeout 3600s;
      proxy_read_timeout 3600s;
      send_timeout 3600s;

      upstream kuma {
        server uptime-kuma.monitoring.svc:80;
        keepalive 32;
      }

      server {
        # 8080, not 80: this container is uid 101 with every capability
        # dropped, so it cannot bind a privileged port. The Service maps
        # 80 -> 8080 so callers are unaffected.
        listen 8080;
        server_name _;

        # Gate order matters: reject floods before spending CPU on PBKDF2.
        limit_req zone=kumareq burst=20 nodelay;
        limit_conn kumaconn 20;

        # Health endpoint stays open (no password) so probes can check the
        # proxy without credentials. Answers locally rather than proxying:
        # anything behind the gate returns 401 to an anonymous probe.
        location = /healthz {
          access_log off;
          default_type text/plain;
          return 200 "ok\n";
        }

        # The gate: the kuma-gate sidecar on loopback validates the signed
        # session cookie. Internal, so nginx never routes to it from outside.
        #
        # 200 = valid session, 401 = no session. nginx distinguishes this
        # from an Uptime-Kuma-issued 401 with $gate_denied (the auth_request
        # subrequest status) and redirects only in that case, so a failed
        # Kuma login shows the Kuma login form rather than looping.
        location = /_gate_authz {
          internal;
          proxy_pass http://127.0.0.1:9001/authz;
          proxy_pass_request_body off;
          proxy_set_header Content-Length "";
          proxy_set_header Cookie $http_cookie;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $http_host;
          proxy_set_header X-Original-URI $request_uri;
        }

        # Login form. Rate limited harder than the app itself because it is
        # the only endpoint that takes a password.
        location = /login {
          limit_req zone=kumalogin burst=10 nodelay;
          proxy_pass http://127.0.0.1:9001;
          proxy_set_header Host $http_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $http_host;
        }

        location = /logout {
          proxy_pass http://127.0.0.1:9001;
          proxy_set_header Host $http_host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header Cookie $http_cookie;
          proxy_set_header X-Forwarded-Proto $scheme;
        }

        location @gate_login {
          # Only reached for the gate's own 401: Kuma's own 401 leaves
          # $gate_denied empty, so error_page falls through and Kuma's
          # response is served as-is.
          if ($gate_denied) {
            return 302 /login;
          }
          return 401;
        }

        location / {
          # Gate first, then proxy to Kuma in the same location: auth_request
          # runs as an access-phase subrequest, so an invalid cookie never
          # reaches Uptime Kuma.
          auth_request /_gate_authz;
          auth_request_set $gate_denied $upstream_status;

          error_page 401 = @gate_login;

          proxy_pass http://kuma;
          proxy_http_version 1.1;

          # Websocket upgrade - Uptime Kuma's socket.io dashboard needs these.
          # The Connection value is mapped, so plain requests get "close".
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $kuma_connection_upgrade;
          proxy_set_header Host uptime-kuma.monitoring.svc;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;

          # Dashboard event/log streams: keep them unbuffered like the ABS
          # audio stream was.
          proxy_buffering off;
        }
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kuma-auth-proxy
  namespace: monitoring
  labels:
    app: kuma-auth-proxy
    app.kubernetes.io/name: kuma-auth-proxy
  annotations:
    kubernetes-specialist/review: "reviewed 2026-10-17; non-root, read-only rootfs, probes, pinned image, resources bounded"
